//	DESC
//		Extension for Chrome-based browsers.
//		Nice extension to auto-duck Youtube tabs if you
//		have multiple running.


{
  "manifest_version": 3,
  "name": "Muffler",
  "version": "1.0.2",
  "description": "Automatically ducks background YouTube tabs and restores the active tab to its full baseline.",
  "author": "Marc-Daniel DALEBA",
  "permissions": [
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}